{
  "expo": {
    "name": "RustPress Admin",
    "slug": "rustpress-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rustpress",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rustpress.admin"
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#0a0a0f" },
      "package": "com.rustpress.admin"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
