{
  "name": "@rustpress/sdk",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript SDK for RustPress CMS API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
