# ============================================================
# RustCMS - Variables de entorno
# Copiar este archivo a backend/.env y completar con valores reales
# ============================================================

# ── Base de datos ─────────────────────────────────────────
DATABASE_URL=postgres://rustcms:rustcms_secret@localhost:5432/rustcms

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=cambiar_por_un_secreto_aleatorio_de_64_caracteres_minimo
JWT_EXPIRY_HOURS=720

# ── Servidor ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
FRONTEND_URL=http://localhost:5173

# ── Archivos / uploads ────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ── Email (SMTP) ──────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@tudominio.com
# Para produccion con Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=tu@gmail.com
# SMTP_PASSWORD=app_password_aqui

# ── Backups ───────────────────────────────────────────────
BACKUP_DIR=./backups

# ── S3 / Cloudflare R2 (opcional) ────────────────────────
# Dejar en blanco para usar almacenamiento local
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_URL=
# Ejemplo Cloudflare R2:
# S3_BUCKET=rustpress-media
# S3_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY=tu_access_key
# S3_SECRET_KEY=tu_secret_key
# S3_REGION=auto
# S3_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Pagos (opcional) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# ── Logs ──────────────────────────────────────────────────
# pretty | json
LOG_FORMAT=pretty
# Nivel: error | warn | info | debug | trace
RUST_LOG=rustcms=debug,actix_web=info
