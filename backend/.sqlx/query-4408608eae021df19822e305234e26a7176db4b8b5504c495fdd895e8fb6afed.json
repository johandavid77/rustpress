  "query": "SELECT * FROM posts\n           WHERE ($1::text IS NULL OR status = $1)\n             AND ($2::text IS NULL OR post_type = $2)\n             AND ($3::uuid IS NULL OR author_id = $3)\n             AND ($4::text IS NULL OR title ILIKE '%' || $4 || '%')\n           ORDER BY created_at DESC\n           LIMIT $5 OFFSET $6",
