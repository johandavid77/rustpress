# ── RustCMS — Variables de entorno ───────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores

# Servidor
HOST=0.0.0.0
PORT=8080
FRONTEND_URL=http://localhost:5173

# Base de datos PostgreSQL
DATABASE_URL=postgres://rustcms:rustcms_secret@localhost:5432/rustcms

# JWT (usa un string largo y aleatorio en producción)
JWT_SECRET=CAMBIA_ESTO_EN_PRODUCCION_usa_openssl_rand_-hex_64
JWT_EXPIRY_HOURS=24

# Almacenamiento de archivos
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Logging (debug | info | warn | error)
RUST_LOG=rustcms=debug,actix_web=info
