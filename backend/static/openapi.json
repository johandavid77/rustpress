{
  "openapi": "3.0.3",
  "info": {
    "title": "RustPress CMS API",
    "description": "API completa del CMS RustPress — construido con Rust + Actix-Web",
    "version": "1.0.0",
    "contact": {
      "name": "RustPress",
      "url": "https://github.com/johandavid77/rustpress"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API v1"
    }
  ],
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "posts"
    },
    {
      "name": "shop"
    },
    {
      "name": "orders"
    },
    {
      "name": "media"
    },
    {
      "name": "users"
    },
    {
      "name": "analytics"
    },
    {
      "name": "settings"
    },
    {
      "name": "plugins"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "responses": {
          "200": {
            "description": "JWT token"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Registro",
        "responses": {
          "201": {
            "description": "Usuario creado"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Perfil actual",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Datos del usuario"
          }
        }
      }
    },
    "/posts": {
      "get": {
        "tags": [
          "posts"
        ],
        "summary": "Listar posts",
        "responses": {
          "200": {
            "description": "Lista de posts"
          }
        }
      },
      "post": {
        "tags": [
          "posts"
        ],
        "summary": "Crear post",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Post creado"
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "tags": [
          "posts"
        ],
        "summary": "Obtener post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post"
          }
        }
      },
      "put": {
        "tags": [
          "posts"
        ],
        "summary": "Editar post",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Actualizado"
          }
        }
      },
      "delete": {
        "tags": [
          "posts"
        ],
        "summary": "Eliminar post",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Eliminado"
          }
        }
      }
    },
    "/shop/products": {
      "get": {
        "tags": [
          "shop"
        ],
        "summary": "Listar productos",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Productos"
          }
        }
      }
    },
    "/shop/products/slug/{slug}": {
      "get": {
        "tags": [
          "shop"
        ],
        "summary": "Producto por slug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Producto"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Listar pedidos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pedidos"
          }
        }
      },
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Crear pedido",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Creado"
          }
        }
      }
    },
    "/payments/init": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Iniciar pago Stripe/PayPal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "URL de pago"
          }
        }
      }
    },
    "/media/upload": {
      "post": {
        "tags": [
          "media"
        ],
        "summary": "Subir archivo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "URL del archivo"
          }
        }
      }
    },
    "/media": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Listar archivos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Archivos"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Listar usuarios",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuarios"
          }
        }
      },
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Crear usuario",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Creado"
          }
        }
      }
    },
    "/analytics/dashboard": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "Métricas generales",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "KPIs"
          }
        }
      }
    },
    "/analytics/revenue-monthly": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "Ingresos por mes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Array mensual"
          }
        }
      }
    },
    "/analytics/top-products-sales": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "Top productos vendidos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Top 10"
          }
        }
      }
    },
    "/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Listar configuraciones",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Config"
          }
        }
      },
      "post": {
        "tags": [
          "settings"
        ],
        "summary": "Guardar configuración",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Guardado"
          }
        }
      }
    },
    "/plugins": {
      "get": {
        "tags": [
          "plugins"
        ],
        "summary": "Listar plugins",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Plugins"
          }
        }
      },
      "post": {
        "tags": [
          "plugins"
        ],
        "summary": "Registrar plugin",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Registrado"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/uptime": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Stats de uptime",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Uptime %"
          }
        }
      }
    }
  }
}